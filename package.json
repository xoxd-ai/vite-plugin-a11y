{
  "name": "@tummycrypt/vite-plugin-a11y",
  "version": "1.0.0",
  "private": true,
  "description": "Vite plugin for accessibility validation of Svelte components - WCAG compliance checking at build time",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "accessibility",
    "a11y",
    "wcag",
    "svelte",
    "contrast",
    "aria",
    "validation"
  ],
  "author": "Tinyland.dev",
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/vite-plugin-a11y.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "magic-string": "^0.30.21",
    "publint": "^0.3.25",
    "svelte": "5.57.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "magic-string": "^0.30.21",
    "svelte": "5.57.2",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/vite-plugin-a11y",
  "bugs": {
    "url": "https://github.com/xoxd-ai/vite-plugin-a11y/issues"
  }
}
