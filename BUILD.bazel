# Consolidation Assessment:
# Evaluated for merge with @tummycrypt/vite-plugin-skeleton-colors (2026-02-09).
# Decision: KEEP SEPARATE.
#   - Zero shared utility functions between the two plugins.
#   - vite-plugin-a11y: WCAG validation (sRGB contrast, ARIA, keyboard nav) using
#     magic-string + svelte/compiler. Operates via Vite transform() hook on .svelte files.
#   - vite-plugin-skeleton-colors: CSS utility generation for Skeleton v4 color pairings
#     using culori (OKLCH color space). Operates via Vite resolveId()/load() virtual modules.
#   - Different runtime deps (magic-string vs culori), different peer deps (svelte vs none).
#   - Shared boilerplate is <10 lines (Plugin type import, fs/path, resolveConfig pattern).
#   - Merging would create unnecessary coupling between unrelated concerns.

"""
BUILD.bazel for @tummycrypt/vite-plugin-a11y.

Dual-mode build: works with both pnpm (standalone) and Bazel (CI/production).
  Standalone: pnpm test
  Gate:       CI (.github/workflows/ci.yml) builds //:pkg //:test.
  Bazel:      bazel build //:pkg && bazel test //... (local, non-qualifying)
  Consumers:  bazel_dep(name = "tummycrypt_vite_plugin_a11y", version = "1.0.0")
              from xoxd-ai/bazel-registry, linked with
              npm_link_package(name = "node_modules/@tummycrypt/vite-plugin-a11y",
                               src = "@tummycrypt_vite_plugin_a11y//:pkg").
              The package is not published to npm (RU6, RU8).
"""

load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_vite_plugin_a11y_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_vite_plugin_a11y_npm//:vitest/package_json.bzl", vitest_bin = "bin")

# =============================================================================
# npm link - makes node_modules available for this package
# =============================================================================

npm_link_all_packages(name = "node_modules")

# Build-time npm deps: the peers (magic-string, svelte, vite) and @types/node.
# They are needed to type-check and compile, and are never linked into
# consumers (see `dist_js`).
BUILD_DEPS = [
    ":node_modules",
    ":node_modules/magic-string",
    ":node_modules/svelte",
    ":node_modules/vite",
    ":node_modules/@types/node",
]

# =============================================================================
# TypeScript compilation
#
# Compiles all .ts sources under src/ to ESM JavaScript with declarations.
# Mirrors the standalone `tsc` build from package.json "build" script.
# =============================================================================

ts_project(
    name = "vite_plugin_a11y",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    declaration_map = True,
    source_map = False,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    validate = False,
    deps = BUILD_DEPS,
    visibility = ["//visibility:public"],
)

# The compiled files only. A filegroup forwards files and drops the
# ts_project's JsInfo, so `pkg` carries no npm_package_store_infos from this
# module's own lock. A consumer's npm_link_package then links the package
# with no private node_modules/{magic-string,svelte,vite}; Node resolves the
# peers from the consuming app's single pnpm lock (RU9; U1 Bazel finding N1).
# ts_project's default outputs are the .js files; the declarations
# (.d.ts, .d.ts.map) come from its `types` output group.
filegroup(
    name = "dist_js",
    srcs = [":vite_plugin_a11y"],
)

filegroup(
    name = "dist_types",
    srcs = [":vite_plugin_a11y"],
    output_group = "types",
)

# =============================================================================
# npm package target
# =============================================================================

npm_package(
    name = "pkg",
    srcs = [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "package.json",
        ":dist_js",
        ":dist_types",
    ],
    # Ship the compiled files and docs only, never runfiles (node_modules).
    include_runfiles = False,
    package = "@tummycrypt/vite-plugin-a11y",
    version = "1.0.0",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Test targets
#
# Runs the vitest suites under tests/ in run mode (no watch).
# =============================================================================

vitest_bin.vitest_test(
    name = "test",
    data = [
        "package.json",
        "tsconfig.json",
        ":node_modules/vitest",
        "vitest.config.ts",
    ] + BUILD_DEPS + glob(["src/**/*.ts"]) + glob(["tests/**/*.ts"]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Typecheck-only target (no emit)
# =============================================================================

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    declaration = False,
    no_emit = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = BUILD_DEPS,
    visibility = ["//visibility:public"],
)

# =============================================================================
# Exported files for downstream consumers
# =============================================================================

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
